# Gemini / Vertex configuration
GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# FAQ knowledge: Atlassian Rovo MCP v2.
ROVO_MCP_URL=https://mcp.atlassian.com/v2/mcp
# Service-account key: set the key and leave email blank (Bearer auth).
# Personal token: set both email and token (Basic auth).
ROVO_MCP_API_KEY=
ROVO_MCP_EMAIL=

# Developer activity logging
BOB_LOG_LEVEL=INFO
BOB_LOG_FILE=logs/bob.log
